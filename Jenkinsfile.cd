def kubectl = 'C:\\Users\\chota\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\kubectl.exe'

pipeline {

    agent any

    environment {
        IMAGE_REPO = "thrilok17/fastapi-japp"
        KUBECONFIG = "C:\\Users\\chota\\.kube\\config"
    }

    parameters {
        string(
            name: "image_tag",
            defaultValue: "latest",
            description: "Docker image tag to deploy"
        )
    }

    stages {

        stage("Check Kubernetes") {
            steps {
                bat """
                "${kubectl}" get nodes
                """
            }
        }

        stage("Deploy FastAPI") {
            steps {
                bat """
                "${kubectl}" apply -f deployment.yaml
                """
            }
        }

        stage("Deploy Service") {
            steps {
                bat """
                "${kubectl}" apply -f service.yaml
                """
            }
        }

        stage("Update Image") {
            steps {
                bat """
                "${kubectl}" set image deployment/fastapi-application ^
                fastapi-application=${env.IMAGE_REPO}:${params.image_tag}
                """
            }
        }

        stage("Run Database Migration") {
            steps {
                bat """
                "${kubectl}" delete job fastapi-migration --ignore-not-found
                "${kubectl}" apply -f migration-job.yaml
                "${kubectl}" set image job/fastapi-migration ^
                 migration=${env.IMAGE_REPO}:${params.image_tag}
                "${kubectl}" wait --for=condition=complete job/fastapi-migration --timeout=120s
                """
           }
        }

        stage("Wait for Deployment") {
            steps {
                bat """
                "${kubectl}" rollout status deployment/fastapi-application --timeout=120s
                """
            }
        }

        stage("Check Pods") {
            steps {
                bat """
                "${kubectl}" get pods
                """
            }
        }

        stage("Health Check") {
            steps {
                bat """
                curl.exe --fail http://api.blogroom.com/health
                """
            }
        }

        stage("Application URL") {
            steps {
                echo "======================================="
                echo "Kubernetes Deployment Successful"
                echo ""
                echo "Application : http://api.blogroom.com"
                echo "Health      : http://api.blogroom.com/health"
                echo "======================================="
            }
        }
    }

    post {

        success {
            echo "Kubernetes CD Successful"
        }

        failure {
            echo "Kubernetes CD Failed"
        }
    }
}