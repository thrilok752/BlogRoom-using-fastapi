def docker = 'C:\\Users\\chota\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe'

pipeline {
    agent any
    parameters{
        string(
            name:"image_tag",
            defaultValue:"latest",
            description:"docker image tag"
        )
    }
    stages {

        stage("Pull image from docker hub") {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerblog',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {

                    bat """
                    echo %DOCKER_PASS%|${docker} login -u %DOCKER_USER% --password-stdin
                    """
                    bat """${docker} pull %DOCKER_USER%/fastapi-japp:${params.image_tag}"""

                    def image_name = ${env.DOCKER_USER}

                    bat "${docker} logout"
                }
            }
        }

        stage("Stop Old Container") {
            steps {
                bat "${docker} stop fastapi-japp || exit /b 0"
            }
        }

        stage("Remove Old Container") {
            steps {
                bat "${docker} rm fastapi-japp || exit /b 0"
            }
        }

        stage("Run Container") {
            steps {
                bat """
                copy D:\\upskill\\fastapi\\blogger\\.env .env
                """
                bat """
                ${docker} run -d ^
                --name fastapi-japp ^
                --env-file .env ^
                -p 8081:8080 ^
                ${image_name}/fastapi-japp:${params.image_tag}
                """
            }
        }

        stage("Wait") {
            steps {
                sleep(time: 8, unit: "SECONDS")
            }
        }

        stage("Health Check") {
            steps {
                bat "curl.exe --fail http://localhost:8081/health"
            }
        }

        stage("Application URL") {
            steps {
                echo "======================================="
                echo "Application Started Successfully"
                echo ""
                echo "Swagger : http://localhost:8081/docs"
                echo "MainURL  : http://localhost:8081"
                echo "======================================="
            }
        }
    }

    post {
        success {
            echo "Deployment Successful"
        }

        failure {
            echo "Deployment Failed"
        }
    }
}