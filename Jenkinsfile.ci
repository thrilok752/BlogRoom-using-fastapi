
def python = 'C:\\Users\\chota\\AppData\\Local\\Python\\pythoncore-3.14-64\\python.exe'
def docker = 'C:\\Users\\chota\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe'

pipeline{
    agent any

    environment {
    IMAGE_REPO = "thrilok17/fastapi-japp"
    }

    parameters{
        string(
            name:"image_tag",
            defaultValue:"latest",
            description:"docker image tag"
        )
    }
    stages {
        stage("checkout"){
            steps{
                checkout scm
            }
        }

        stage("Verify Environment"){
            steps{
                bat "${python} --version"
                bat "${python} -m uv --version"
                bat "${docker} --version"
            }

        }

        stage("install dependencies"){
            steps{
                bat "${python} -m uv sync --locked"
            }
        }

        stage("Lint"){
            steps{
                bat "${python} -m uv run ruff check ."
            }
        }

        stage("Testing/Unit Test"){
            steps{
                bat "${python} -m uv run pytest"
            }
        }

        stage("Docker Build"){
            steps{
                bat "${docker} build -t fastapi-japp:latest ."
            }
        }

        stage("Run Container"){
            steps {
                bat """
                copy D:\\upskill\\fastapi\\blogger\\.env .env
                """
                bat "${docker} rm -f fastapi-japp"
                bat """
                ${docker} run -d ^
                --name fastapi-japp ^
                --env-file .env ^
                -p 8081:8080 ^
                fastapi-japp:latest
                """
            }
        }

        stage("Wait") {
            steps {
                sleep(time: 8, unit: "SECONDS")
            }
        }

        stage("Health"){
            steps {
                bat "curl.exe http://localhost:8081/health"
            }
        }

        stage("Docker Hub"){
            steps {
                withCredentials([usernamePassword(
                    credentialsId: "dockerblog",
                    usernameVariable: "DOCKER_USER",
                    passwordVariable: "DOCKER_PASS"
                )]) {
                    bat """
                    echo %DOCKER_PASS%| ${docker} login -u %DOCKER_USER% --password-stdin
                    """
                    bat """
                    ${docker} tag fastapi-japp:latest ${env.IMAGE_REPO}:${params.image_tag}
                    """
                    bat """
                    ${docker} tag fastapi-japp:latest ${env.IMAGE_REPO}:latest
                    """
                    bat """
                    ${docker} push ${env.IMAGE_REPO}:${params.image_tag}
                    """
                     bat """
                    ${docker} push ${env.IMAGE_REPO}:latest
                    """

                    bat "${docker} logout"
                }
            }
        
        }
    }
    post{
        always{
            bat "del .env"
            bat "${docker} logs fastapi-japp || exit /b 0"
            bat "${docker} rm -f fastapi-japp || exit /b 0"
        }
        success{
            echo "========build is successfull  ========"
            build job: "jen run image",
            parameters: [string(name: 'image_tag', value: params.image_tag)]
        }
        failure{
            echo "========pipeline execution failed========"
        }
    }
}

